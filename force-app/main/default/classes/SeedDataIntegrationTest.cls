            new Vehicle__c(Registration_Number__c = 'DL01 FG 4466', Make__c = 'Hyundai', Model__c = 'Verna', Year__c = 2023, Category__c = 'Sedan', Transmission__c = 'Automatic', Fuel_Type__c = 'Petrol', Seats__c = 5, Daily_Rate__c = 3100, Security_Deposit__c = 4000, Odometer__c = 11800, Next_Service_Date__c = Date.today().addDays(55), Status__c = 'Available', Image_URL__c = 'https://placehold.co/640x400/0B5CAB/FFFFFF?text=Hyundai%20Verna', Branch__c = branchByName.get('Delhi Central').Id),
            new Vehicle__c(Registration_Number__c = 'DL01 HJ 6688', Make__c = 'MG', Model__c = 'ZS EV', Year__c = 2024, Category__c = 'Electric', Transmission__c = 'Automatic', Fuel_Type__c = 'Electric', Seats__c = 5, Daily_Rate__c = 3900, Security_Deposit__c = 6000, Odometer__c = 4300, Next_Service_Date__c = Date.today().addDays(200), Status__c = 'Available', Image_URL__c = 'https://placehold.co/640x400/0B5CAB/FFFFFF?text=MG%20ZS%20EV', Branch__c = branchByName.get('Delhi Central').Id),
            new Vehicle__c(Registration_Number__c = 'DL01 KL 8800', Make__c = 'BMW', Model__c = '3 Series', Year__c = 2023, Category__c = 'Luxury', Transmission__c = 'Automatic', Fuel_Type__c = 'Petrol', Seats__c = 5, Daily_Rate__c = 9500, Security_Deposit__c = 20000, Odometer__c = 9700, Next_Service_Date__c = Date.today().addDays(80), Status__c = 'Available', Image_URL__c = 'https://placehold.co/640x400/0B5CAB/FFFFFF?text=BMW%203%20Series', Branch__c = branchByName.get('Delhi Central').Id),
            new Vehicle__c(Registration_Number__c = 'DL01 MN 1010', Make__c = 'Maruti', Model__c = 'Dzire', Year__c = 2023, Category__c = 'Sedan', Transmission__c = 'Manual', Fuel_Type__c = 'CNG', Seats__c = 5, Daily_Rate__c = 1900, Security_Deposit__c = 2000, Odometer__c = 26200, Next_Service_Date__c = Date.today().addDays(4), Status__c = 'Available', Image_URL__c = 'https://placehold.co/640x400/0B5CAB/FFFFFF?text=Maruti%20Dzire', Branch__c = branchByName.get('Delhi Central').Id),
            new Vehicle__c(Registration_Number__c = 'DL01 PQ 3030', Make__c = 'Kia', Model__c = 'Sonet', Year__c = 2024, Category__c = 'SUV', Transmission__c = 'Automatic', Fuel_Type__c = 'Diesel', Seats__c = 5, Daily_Rate__c = 2800, Security_Deposit__c = 4000, Odometer__c = 7600, Next_Service_Date__c = Date.today().addDays(100), Status__c = 'Available', Image_URL__c = 'https://placehold.co/640x400/0B5CAB/FFFFFF?text=Kia%20Sonet', Branch__c = branchByName.get('Delhi Central').Id),
            new Vehicle__c(Registration_Number__c = 'DL01 RS 5050', Make__c = 'Mahindra', Model__c = 'Scorpio-N', Year__c = 2023, Category__c = 'SUV', Transmission__c = 'Manual', Fuel_Type__c = 'Diesel', Seats__c = 7, Daily_Rate__c = 4000, Security_Deposit__c = 6000, Odometer__c = 16500, Next_Service_Date__c = Date.today().addDays(35), Status__c = 'Available', Image_URL__c = 'https://placehold.co/640x400/0B5CAB/FFFFFF?text=Mahindra%20Scorpio-N', Branch__c = branchByName.get('Delhi Central').Id)
        };
        upsert as system vehicleSeed Registration_Number__c;
        Map<String, Vehicle__c> vehicleByReg = new Map<String, Vehicle__c>();
        for (Vehicle__c v : [SELECT Id, Registration_Number__c, Daily_Rate__c, Security_Deposit__c, Branch__c, Odometer__c FROM Vehicle__c WITH SYSTEM_MODE]) {
            vehicleByReg.put(v.Registration_Number__c, v);
        }

        // ---- customers: Contact is the customer master (TDD D2) ----
        List<Account> accts = [SELECT Id FROM Account WHERE Name = 'Smart Car Rental Customers' WITH SYSTEM_MODE LIMIT 1];
        Account customers = accts.isEmpty() ? new Account(Name = 'Smart Car Rental Customers') : accts[0];
        if (customers.Id == null) { insert as system customers; }
        Map<String, Contact> byEmail = new Map<String, Contact>();
        for (Contact c : [SELECT Id, Email FROM Contact WHERE Email IN ('rahul.sharma@example.com', 'priya.verma@example.com') WITH SYSTEM_MODE]) { byEmail.put(c.Email, c); }
        Contact verified = byEmail.get('rahul.sharma@example.com') ?? new Contact(Email = 'rahul.sharma@example.com');
        verified.AccountId = customers.Id; verified.FirstName = 'Rahul'; verified.LastName = 'Sharma'; verified.Phone = '+91 98000 00001';
        verified.Birthdate = Date.newInstance(1992, 3, 14); verified.Driving_License_Number__c = 'RJ1420150099999'; // fictitious
        verified.License_Expiry__c = Date.today().addYears(12); verified.License_Name_OCR__c = 'RAHUL SHARMA';
        verified.KYC_Status__c = 'Verified'; verified.KYC_Confidence__c = 96; verified.KYC_Verified_At__c = System.now().addDays(-40);
        Contact unverified = byEmail.get('priya.verma@example.com') ?? new Contact(Email = 'priya.verma@example.com');
        unverified.AccountId = customers.Id; unverified.FirstName = 'Priya'; unverified.LastName = 'Verma'; unverified.Phone = '+91 98000 00002';
        unverified.KYC_Status__c = 'Not Submitted';
        upsert as system new List<Contact>{ verified, unverified };

        if ([SELECT COUNT() FROM Booking__c WHERE Customer__c IN (:verified.Id, :unverified.Id) WITH SYSTEM_MODE] > 0) {
            System.debug('Demo bookings already exist – skipping bookings, payments, inspections and maintenance.');
            return;
        }

        BookingTriggerHandler.bypassGuards = true; // seed only: historical bookings are created directly in their final state

        Datetime now0 = System.now();
        // [vehicle reg, customer, start offset days, length days, status]
        List<Object[]> plan = new List<Object[]>{
            new Object[]{ 'RJ14 JK 1357', verified,   -30, 3, 'Completed' },   // clean return
            new Object[]{ 'RJ14 GH 2468', verified,   -20, 2, 'Completed' },   // minor damage
            new Object[]{ 'DL01 QR 4455', verified,   -12, 4, 'Completed' },   // late return + major damage -> approval
            new Object[]{ 'RJ14 LM 8642', unverified,  -8, 2, 'Cancelled' },   // cancelled hold
            new Object[]{ 'RJ14 CD 5678', verified,    -3, 2, 'Active' },      // overdue
            new Object[]{ 'RJ14 NP 7531', verified,     5, 3, 'Confirmed' }    // upcoming
        };
        List<Booking__c> bookings = new List<Booking__c>();
        for (Object[] p : plan) {
            Vehicle__c v = vehicleByReg.get((String) p[0]);
            Datetime s = now0.addDays((Integer) p[2]);
            Datetime e = s.addDays((Integer) p[3]);
            String finalStatus = (String) p[4];
            PricingService.Quote q = PricingService.calculate(v, s, e);
            Boolean throughFlows = finalStatus == 'Completed' || finalStatus == 'Active';
            bookings.add(new Booking__c(
                Customer__c = ((Contact) p[1]).Id, Vehicle__c = v.Id, Pickup_Branch__c = v.Branch__c,
                Start_DateTime__c = s, End_DateTime__c = e, Rental_Days__c = q.days,
                Total_Amount__c = q.total, Deposit_Amount__c = q.deposit, Source__c = 'Staff',
                // Completed / Active bookings start as Confirmed and are driven through the real inspection flows below
                Status__c = throughFlows ? 'Confirmed' : finalStatus,
                Payment_Status__c = finalStatus == 'Cancelled' ? 'Unpaid' : 'Paid'
            ));
        }
        insert as system bookings;

        List<Payment__c> payments = new List<Payment__c>();
        for (Integer i = 0; i < bookings.size(); i++) {
            Booking__c b = bookings[i];
            if (b.Payment_Status__c == 'Paid') {
                payments.add(new Payment__c(Booking__c = b.Id, Amount__c = b.Total_Amount__c + b.Deposit_Amount__c, Currency_Code__c = 'INR',
                    Stripe_Session_Id__c = 'cs_test_seed_' + i + '_' + b.Id, Stripe_Payment_Intent_Id__c = 'pi_test_seed_' + i,
                    Status__c = 'Succeeded', Paid_At__c = b.Start_DateTime__c.addDays(-2)));
            }
        }
        insert as system payments;

        // Pickup inspections -> flow Inspection_Pickup sets the booking Active and the vehicle Rented
        List<Inspection__c> pickups = new List<Inspection__c>();
        for (Integer i = 0; i < bookings.size(); i++) {
            String finalStatus = (String) plan[i][4];
            if (finalStatus == 'Completed' || finalStatus == 'Active') {
                Booking__c b = bookings[i];
                pickups.add(new Inspection__c(Booking__c = b.Id, Type__c = 'Pickup', Inspection_Date__c = b.Start_DateTime__c,
                    Odometer__c = vehicleByReg.get((String) plan[i][0]).Odometer__c, Fuel_Level__c = 'Full',
                    Exterior_Condition__c = 'Good', Interior_Condition__c = 'Excellent', Damage_Notes__c = 'No visible damage.'));
            }
        }
        insert as system pickups;

        // Return inspections -> flow Inspection_Return_Report completes the booking (late fee, odometer) and,
        // asynchronously, generates the damage report and submits large charges for approval.
        List<Inspection__c> returns = new List<Inspection__c>{
            new Inspection__c(Booking__c = bookings[0].Id, Type__c = 'Return', Inspection_Date__c = bookings[0].End_DateTime__c.addHours(-1),
                Odometer__c = vehicleByReg.get('RJ14 JK 1357').Odometer__c + 412, Fuel_Level__c = 'Full',
                Exterior_Condition__c = 'Good', Interior_Condition__c = 'Excellent', Damage_Notes__c = 'No visible damage.'),
            new Inspection__c(Booking__c = bookings[1].Id, Type__c = 'Return', Inspection_Date__c = bookings[1].End_DateTime__c.addMinutes(-30),
                Odometer__c = vehicleByReg.get('RJ14 GH 2468').Odometer__c + 268, Fuel_Level__c = '3/4',
                Exterior_Condition__c = 'Minor Damage', Interior_Condition__c = 'Excellent', Damage_Notes__c = 'Scratch on rear bumper.',
                Damage_Detected__c = true, Estimated_Charge__c = 1500),
            new Inspection__c(Booking__c = bookings[2].Id, Type__c = 'Return', Inspection_Date__c = bookings[2].End_DateTime__c.addHours(5),
                Odometer__c = vehicleByReg.get('DL01 QR 4455').Odometer__c + 655, Fuel_Level__c = '1/2',
                Exterior_Condition__c = 'Major Damage', Interior_Condition__c = 'Good', Damage_Notes__c = 'Dent on driver door; cracked left tail lamp.',
                Damage_Detected__c = true, Estimated_Charge__c = 12000)
        };
        insert as system returns;

        // The Active booking is past its planned end -> overdue (normally flagged by the hourly BookingOverdueBatch)
        Booking__c overdue = bookings[4];
        update as system new Booking__c(Id = overdue.Id, Is_Overdue__c = true);

        // Maintenance (flow Maintenance_Vehicle_Status_Sync sets In Progress vehicles to Maintenance)
        insert as system new List<Maintenance__c>{
            new Maintenance__c(Vehicle__c = vehicleByReg.get('RJ14 EF 9101').Id, Issue__c = 'Scheduled 30,000 km service', Priority__c = 'Medium',
                Due_Date__c = Date.today().addDays(5), Status__c = 'Open'),
            new Maintenance__c(Vehicle__c = vehicleByReg.get('DL01 MN 1010').Id, Issue__c = 'Brake pads replacement', Priority__c = 'High',
                Due_Date__c = Date.today().addDays(1), Status__c = 'In Progress', Cost__c = 4200),
            new Maintenance__c(Vehicle__c = vehicleByReg.get('RJ14 DE 2233').Id, Issue__c = 'AC compressor check', Priority__c = 'Low',
                Due_Date__c = Date.today().addDays(-10), Status__c = 'Closed', Cost__c = 1800, Closed_Date__c = Date.today().addDays(-9))
        };

        BookingTriggerHandler.bypassGuards = false;
        System.debug('Seed complete: ' + bookings.size() + ' bookings, ' + payments.size() + ' payments, ' + (pickups.size() + returns.size()) + ' inspections.');
    }
}