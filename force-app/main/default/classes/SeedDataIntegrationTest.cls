/**
 * End-to-end integration test: runs scripts/data/seed.apex (GENERATED from scripts/data/generate-seed.js – do not
 * edit by hand) and asserts the full lifecycle through the real triggers, flows, queueable and approval process:
 * pickup -> Active/Rented, return -> Completed + late fee, overdue, maintenance status sync, damage report, approval.
 */
@IsTest
private class SeedDataIntegrationTest {
    @IsTest
    static void seedRunsThroughTheRealFlows() {
        TestDataFactory.useTestConfig();
        Test.startTest();
        run();
        Test.stopTest();
        Assert.areEqual(3, [SELECT COUNT() FROM Branch__c]);
        Assert.areEqual(20, [SELECT COUNT() FROM Vehicle__c]);
        Assert.areEqual(3, [SELECT COUNT() FROM Booking__c WHERE Status__c = 'Completed'], String.valueOf([SELECT Name, Status__c FROM Booking__c]));
        Assert.areEqual(1, [SELECT COUNT() FROM Booking__c WHERE Status__c = 'Active' AND Is_Overdue__c = TRUE]);
        Assert.isTrue([SELECT Late_Fee__c FROM Booking__c WHERE Vehicle__r.Registration_Number__c = 'DL01 QR 4455'].Late_Fee__c > 0, 'late return fee');
        Assert.areEqual('Maintenance', [SELECT Status__c FROM Vehicle__c WHERE Registration_Number__c = 'DL01 MN 1010'].Status__c);
        Assert.areEqual('Rented', [SELECT Status__c FROM Vehicle__c WHERE Registration_Number__c = 'RJ14 CD 5678'].Status__c);
        Integer reports = 0;
        for (Inspection__c i : [SELECT AI_Summary__c FROM Inspection__c WHERE Type__c = 'Return']) { if (i.AI_Summary__c != null) { reports++; } }
        Assert.areEqual(3, reports, 'damage reports generated by DamageReportQueueable');
        Assert.areEqual(1, [SELECT COUNT() FROM ProcessInstance WHERE Status = 'Pending'], 'major damage routed for approval');
    }

