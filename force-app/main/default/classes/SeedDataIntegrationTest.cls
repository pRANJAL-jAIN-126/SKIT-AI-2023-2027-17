            new Vehicle__c(Registration_Number__c = 'RJ14 YZ 7788', Make__c = 'Toyota', Model__c = 'Fortuner', Year__c = 2022, Category__c = 'Luxury', Transmission__c = 'Automatic', Fuel_Type__c = 'Diesel', Seats__c = 7, Daily_Rate__c = 6500, Security_Deposit__c = 10000, Odometer__c = 34800, Next_Service_Date__c = Date.today().addDays(25), Status__c = 'Available', Image_URL__c = 'https://placehold.co/640x400/0B5CAB/FFFFFF?text=Toyota%20Fortuner', Branch__c = branchByName.get('Jaipur City').Id),
