            new Vehicle__c(Registration_Number__c = 'RJ14 UV 3344', Make__c = 'Tata', Model__c = 'Punch', Year__c = 2024, Category__c = 'Hatchback', Transmission__c = 'Manual', Fuel_Type__c = 'CNG', Seats__c = 5, Daily_Rate__c = 1600, Security_Deposit__c = 2000, Odometer__c = 5200, Next_Service_Date__c = Date.today().addDays(160), Status__c = 'Available', Image_URL__c = 'https://placehold.co/640x400/0B5CAB/FFFFFF?text=Tata%20Punch', Branch__c = branchByName.get('Jaipur Airport').Id),
