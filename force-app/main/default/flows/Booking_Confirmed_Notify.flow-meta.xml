    <description>TDD §12 / Plan Phase 8 – Booking_Confirmed_Notify. Fires once when a Booking__c is updated so that Status__c becomes Confirmed (entry criteria evaluated only on change). Sends the classic email template Booking_Confirmation to the customer contact (merge record = booking, logged on send) and an in-app Rental_Booking_Alert notification to the booking owner (if a user) and the pickup branch manager. All failures are swallowed via fault paths so the payment confirmation is never rolled back.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxAddManager</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISBLANK({!$Record.Pickup_Branch__r.Manager__c})), OR(LEFT({!$Record.OwnerId}, 3) &lt;&gt; &quot;005&quot;, {!$Record.Pickup_Branch__r.Manager__c} &lt;&gt; {!$Record.OwnerId}))</expression>
    </formulas>
    <formulas>
        <name>fxOwnerIsUser</name>
        <dataType>Boolean</dataType>
        <expression>LEFT({!$Record.OwnerId}, 3) = &quot;005&quot;</expression>
    </formulas>
    <interviewLabel>Booking Confirmed Notify {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Booking Confirmed Notify</label>
