<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Seats_Between_2_And_9</fullName>
    <active>true</active>
    <description>TDD 6.2</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Seats__c)), OR(Seats__c &lt; 2, Seats__c &gt; 9))</errorConditionFormula>
    <errorDisplayField>Seats__c</errorDisplayField>
    <errorMessage>Seats must be between 2 and 9.</errorMessage>
</ValidationRule>
