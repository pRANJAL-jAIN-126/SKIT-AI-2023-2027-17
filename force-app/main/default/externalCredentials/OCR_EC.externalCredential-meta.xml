<?xml version="1.0" encoding="UTF-8"?>
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <authenticationProtocol>Custom</authenticationProtocol>
    <description>OCR API credential (TDD 10). The secret is entered in Setup on principal OCR_Principal and is never stored in source.</description>
    <externalCredentialParameters>
        <parameterGroup>OCR_Principal</parameterGroup>
        <parameterName>OCR_Principal</parameterName>
        <parameterType>NamedPrincipal</parameterType>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <parameterGroup>DefaultGroup</parameterGroup>
        <parameterName>apikey</parameterName>
        <parameterType>AuthHeader</parameterType>
        <parameterValue>{!$Credential.OCR_EC.ApiKey}</parameterValue>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <label>OCR_EC</label>
</ExternalCredential>
